# Variables Parla reads. `make run` loads this file; otherwise export them in your shell
# (or `set -a; . ./.env; set +a`) before running app.py / mcp_server.py.

# --- server (app.py) ---
# Default interface language for anyone who hasn't picked one: en, es or pt. Default: the browser's language
# PARLA_LANG=en
# Data folder: agents, conversations, users.json and voice models. Default <repo>/data
# PARLA_DATA=/path/to/data
# Users file (login). Default $PARLA_DATA/users.json. If it's missing or empty, there's no login.
# PARLA_USERS=/path/to/users.json
# "function" steps (the bots' Python/JS code). 0/false/no/off turns them off. Default 1
# PARLA_FUNCTIONS=1
# faster-whisper model for voice: tiny, base, small… Default base ("tiny" if the machine is slow)
# PARLA_WHISPER=base
# Public HTTPS address, for the WhatsApp and Telegram webhooks (docs/channels.md). Default empty
# PARLA_PUBLIC_URL=https://bots.midominio.com
# Delete conversations idle for more than N days (an agent's retention_days wins; 0 = keep forever). Default: keep forever
# PARLA_RETENTION_DAYS=90
# Days the audit log is kept. Default 365
# PARLA_AUDIT_DAYS=365

# --- single sign-on with OIDC (docs/sso.md) ---
# Your identity provider's issuer and this app's client id. Both set = "Sign in with …" on the login screen
# PARLA_OIDC_ISSUER=https://kc.example.com/realms/acme
# PARLA_OIDC_CLIENT_ID=parla
# Client secret, or better a file that holds it (Docker/Kubernetes secrets; the file wins)
# PARLA_OIDC_CLIENT_SECRET=
# PARLA_OIDC_CLIENT_SECRET_FILE=/run/secrets/parla-oidc
# Scopes to request. Default "openid email profile"
# PARLA_OIDC_SCOPES=openid email profile
# Claim with the groups/roles (exact key, then dotted path like realm_access.roles) and group:role pairs
# (roles: owner, editor, analyst, agent; the highest wins)
# PARLA_OIDC_ROLE_CLAIM=groups
# PARLA_OIDC_ROLE_MAP=parla-owners:owner,parla-editors:editor
# Role for anyone without a mapped group. Default empty: they're denied
# PARLA_OIDC_DEFAULT_ROLE=analyst
# 1 = no password login, except an owner on this same machine (break-glass)
# PARLA_OIDC_ONLY=1
# Button text "Sign in with {label}". Default SSO
# PARLA_OIDC_LABEL=Acme
# 0 = on logout, don't send the browser to the provider's logout page (needed for Okta)
# PARLA_OIDC_LOGOUT=0
# Also set PARLA_PUBLIC_URL (above) and PARLA_HOSTS=bots.midominio.com when it's behind a proxy

# --- MCP server (mcp_server.py) ---
# Where Parla is. Default http://127.0.0.1:8000
# PARLA_URL=http://127.0.0.1:8000
# Parla API key (required if there are users); sent as Authorization: Bearer
# PARLA_TOKEN=
# With --http behind a proxy: extra accepted hosts, comma-separated
# PARLA_MCP_ALLOWED_HOSTS=bots.midominio.com
