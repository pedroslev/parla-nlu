# Variables que lee Parla. Nada carga este archivo solo: exportalas en tu shell
# (o `set -a; . ./.env; set +a`) antes de correr app.py / mcp_server.py.

# --- servidor (app.py) ---
# Carpeta de datos: agentes, conversaciones, users.json y modelos de voz. Por defecto <repo>/data
# PARLA_DATA=/ruta/a/datos
# Archivo de usuarios (login). Por defecto $PARLA_DATA/users.json. Si no existe o está vacío, no hay login.
# PARLA_USERS=/ruta/a/users.json
# Pasos «función» (código Python/JS de los bots). 0/false/no/off los apaga. Por defecto 1
# PARLA_FUNCTIONS=1
# Modelo de faster-whisper para la voz: tiny, base, small… Por defecto base ("tiny" si la máquina es lenta)
# PARLA_WHISPER=base

# --- servidor MCP (mcp_server.py) ---
# Dónde está Parla. Por defecto http://127.0.0.1:8000
# PARLA_URL=http://127.0.0.1:8000
# Clave de API de Parla (necesaria si hay usuarios); se manda como Authorization: Bearer
# PARLA_TOKEN=
# Con --http detrás de un proxy: hosts extra aceptados, separados por coma
# PARLA_MCP_ALLOWED_HOSTS=bots.midominio.com
