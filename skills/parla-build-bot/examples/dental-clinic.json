    "functions": [
      {
        "name": "formatear_fecha",
        "description": "Fecha ISO -> «martes 15/12 a las 10:00»; falla los domingos",
        "language": "python",
        "inputs": [
          "fecha"
        ],
        "code": "from datetime import datetime\n\nDIAS = [\"lunes\", \"martes\", \"miércoles\", \"jueves\", \"viernes\", \"sábado\", \"domingo\"]\n\n\ndef run(inputs):\n    raw = inputs.get(\"fecha\") or \"\"            # \"2026-12-15\" o \"2026-12-15T10:00\" (entidad date)\n    when = datetime.fromisoformat(raw)\n    if when.weekday() == 6:\n        raise ValueError(\"Los domingos la clínica está cerrada\")\n    texto = \"%s %d/%d\" % (DIAS[when.weekday()], when.day, when.month)\n    if \"T\" in raw:\n        texto += \" a las \" + when.strftime(\"%H:%M\")\n    return {\"fecha_texto\": texto}\n"
      }
    ]
  }
