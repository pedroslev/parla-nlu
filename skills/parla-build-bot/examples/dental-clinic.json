            "slot": "fecha",
            "text": "¿Qué día y a qué hora te queda bien? Por ejemplo: «el jueves a las 10»."
          },
          {
            "type": "function",
            "function": "formatear_fecha",
            "saves": [
              {
                "expr": "ok",
                "slot": "fecha_ok"
              },
              {
                "expr": "ok ? '' : error",
                "slot": "fecha_error"
              }
            ]
          },
          {
            "type": "if",
            "cond": {
              "var": "fecha_ok",
              "op": "eq",
              "value": "false"
            },
            "then": [
              {
                "type": "message",
                "text": "{{ fecha_error }}. Elegí otro día, por favor."
              },
              {
                "type": "set",
                "slot": "fecha",
                "mode": "clear"
              },
              {
                "type": "goto",
                "flow": "Reservar turno"
              }
            ],
            "else": []
          },
          {
            "type": "ask",
            "slot": "nombre",
            "text": "¿A nombre de quién reservo?"
          },
          {
            "type": "ask",
            "slot": "telefono",
            "text": "¿A qué teléfono te escribimos si hay un cambio?"
          },
          {
            "type": "ask",
            "slot": "confirma",
            "text": "Reviso: {{ tratamiento }} el {{ fecha_texto }} a nombre de {{ nombre }}. ¿Lo confirmo?",
            "buttons": [
              {
                "label": "Sí, confirmar",
                "value": "si"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          },
          {
            "type": "if",
            "cond": {
              "var": "confirma",
              "op": "eq",
              "value": "no"
            },
            "then": [
              {
                "type": "message",
                "text": "Listo, no reservé nada. Cuando quieras empezamos de nuevo."
              },
              {
                "type": "set",
                "slot": "confirma",
                "mode": "clear"
              },
              {
                "type": "set",
                "slot": "fecha",
                "mode": "clear"
              },
              {
                "type": "end"
              }
            ],
            "else": []
          },
          {
            "type": "http",
            "method": "POST",
            "url": "http://127.0.0.1:8766/reservas",
            "headers": [
              {
                "key": "Authorization",
                "value": "Bearer {{ secret.BOOKING_TOKEN }}"
              }
            ],
            "body": "{\"fecha\": \"{{ fecha }}\", \"telefono\": \"{{ telefono }}\", \"tratamiento\": \"{{ tratamiento }}\"}",
            "saves": [
              {
                "expr": "status",
                "slot": "reserva_status"
              },
              {
                "expr": "has(body.code) ? body.code : ''",
                "slot": "reserva_codigo"
              }
            ]
          },
          {
            "type": "if",
            "cond": {
              "var": "reserva_status",
              "op": "eq",
              "value": "201"
            },
            "then": [
              {
                "type": "message",
                "text": "¡Listo, {{ nombre }}! Tu turno de {{ tratamiento }} quedó reservado para el {{ fecha_texto }}. Código: {{ reserva_codigo }}."
              },
              {
                "type": "classify",
                "classification": "Turno reservado"
              }
            ],
            "else": [
              {
                "type": "classify",
                "classification": "Reserva fallida"
              },
              {
                "type": "handoff",
                "reason": "el sistema de reservas no confirmó el turno",
                "text": "No pude confirmar el turno en el sistema. Te paso con alguien de recepción para terminarlo."
              }
            ]
          },
          {
            "type": "set",
            "slot": "tratamiento",
            "mode": "clear"
          },
          {
            "type": "set",
            "slot": "fecha",
            "mode": "clear"
          },
          {
            "type": "set",
            "slot": "confirma",
            "mode": "clear"
          }
        ]
